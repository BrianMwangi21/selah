# === Selah — environment ===
# Copy this file to `.env` and fill in the values. `.env` is gitignored.

# --- Google / Gemini (models: Gemini text + Lyria music + Imagen art) ---
# From aistudio.google.com -> Get API key -> created in the "selah" Cloud project.
GEMINI_API_KEY=

# Default model for lyrics + meta (cheap, plenty good for lyrics).
GEMINI_LYRICS_MODEL=gemini-3.7-flash

# --- Lyria (music) ---
# Preview = cheap 30s clip to audition the vibe; Pro = full multi-minute render.
LYRIA_PREVIEW_MODEL=lyria-3-clip-preview
LYRIA_FULL_MODEL=lyria-3-pro-preview

# --- Cover art (Nano Banana / Gemini image) ---
# 1:1 for album covers, 16:9 for video-ready art.
IMAGE_MODEL=gemini-3.1-flash-image
COVER_ASPECT=1:1
COVER_SIZE=2K

# --- Storage ---
# Root folder for generated songs (one subfolder per track: songs/<slug>/).
SONGS_DIR=songs
